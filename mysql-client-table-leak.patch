mysql leaked a buffer in print_table_data() when it returned before using
it (Bug#36600203).
https://github.com/percona/percona-server/commit/d03ad650df (https://github.com/mysql/mysql-server/commit/de82d8ade0a)

--- percona-server-5.6.51-91.0.orig/client/mysql.cc
+++ percona-server-5.6.51-91.0/client/mysql.cc
@@ -3790,8 +3790,6 @@ print_table_data(MYSQL_RES *result)
   bool		*num_flag;
   size_t        sz;
 
-  sz= sizeof(bool) * mysql_num_fields(result);
-  num_flag= (bool *) my_safe_alloca(sz, MAX_ALLOCA_SIZE);
   if (column_types_flag)
   {
     print_field_types(result);
@@ -3799,6 +3797,8 @@ print_table_data(MYSQL_RES *result)
       return;
     mysql_field_seek(result,0);
   }
+  sz= sizeof(bool) * mysql_num_fields(result);
+  num_flag= (bool *) my_safe_alloca(sz, MAX_ALLOCA_SIZE);
   separator.copy("+",1,charset_info);
   while ((field = mysql_fetch_field(result)))
   {
