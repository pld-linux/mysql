Improve validation for malformed replication metadata (Bug#39253383)
https://github.com/percona/percona-server/commit/f3a20570b1
https://github.com/mysql/mysql-server/commit/2df704674af

--- mysql-5.7.44.orig/libbinlogevents/src/rows_event.cpp
+++ mysql-5.7.44/libbinlogevents/src/rows_event.cpp
@@ -121,10 +121,22 @@ Table_map_event::Table_map_event(const char *buf, unsigned int event_len,
   /* Extract the length of the various parts from the buffer */
   unsigned char const *const ptr_dblen= (unsigned char const*)vpart + 0;
   m_dblen= *(unsigned char*) ptr_dblen;
+  if (m_dblen > NAME_LEN)
+  {
+    /* Invalid database name length */
+    m_coltype= NULL;
+    return;
+  }
 
   /* Length of database name + counter + terminating null */
   unsigned char const *const ptr_tbllen= ptr_dblen + m_dblen + 2;
   m_tbllen= *(unsigned char*) ptr_tbllen;
+  if (m_tbllen > NAME_LEN)
+  {
+    /* Invalid table name length */
+    m_coltype= NULL;
+    return;
+  }
 
   /* Length of table name + counter + terminating null */
   unsigned char const *const ptr_colcnt= ptr_tbllen + m_tbllen + 2;
