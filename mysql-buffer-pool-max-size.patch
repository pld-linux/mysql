Startup with an innodb_buffer_pool_size near the address space limit crashed
on a failed chunk array allocation instead of failing (Bug#37994397); the
error path releases buf_pool->mutex, the mutex 5.7 holds there.
https://github.com/percona/percona-server/commit/90905441b2
https://github.com/mysql/mysql-server/commit/2c6e56c3bd4

--- mysql-5.7.44.orig/storage/innobase/buf/buf0buf.cc
+++ mysql-5.7.44/storage/innobase/buf/buf0buf.cc
@@ -1761,6 +1761,18 @@ buf_pool_init_instance(
 		buf_pool->chunks =
 			reinterpret_cast<buf_chunk_t*>(ut_zalloc_nokey(
 				buf_pool->n_chunks * sizeof(*chunk)));
+		DBUG_EXECUTE_IF("buf_pool_chunk_alloc_fail", {
+			if (buf_pool->chunks) {
+				ut_free(buf_pool->chunks);
+			}
+			buf_pool->chunks = NULL;
+		});
+		if (buf_pool->chunks == NULL) {
+			ib::error() << "Buffer pool " << instance_no
+						<< " : failed to allocate the chunk array.";
+			buf_pool_mutex_exit(buf_pool);
+			return(DB_ERROR);
+		}
 		buf_pool->chunks_old = NULL;
 
 		UT_LIST_INIT(buf_pool->LRU, &buf_page_t::LRU);
