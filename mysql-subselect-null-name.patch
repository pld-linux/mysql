A substituted subquery gave its replacement item a NULL name, crashing the
server when sending result metadata (Bug#35904044).
https://github.com/percona/percona-server/commit/d3a00fe2c1 (https://github.com/mysql/mysql-server/commit/271dcf231d0)

--- percona-server-5.6.51-91.0.orig/sql/item_subselect.cc
+++ percona-server-5.6.51-91.0/sql/item_subselect.cc
@@ -408,7 +408,8 @@ bool Item_subselect::fix_fields(THD *thd, Item **ref)
 	unit->outer_select()->having= substitution; // correct HAVING for PS
 
       (*ref)= substitution;
-      substitution->item_name= item_name;
+      if (item_name.is_set())
+        substitution->item_name= item_name;
       if (have_to_be_excluded)
 	engine->exclude();
       substitution= 0;
