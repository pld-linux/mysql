MAKE_SET() kept the used tables of its first argument stale after a
semijoin pullout, the argument is not in args[] (Bug#35846221).
https://github.com/percona/percona-server/commit/5deacc558c (https://github.com/mysql/mysql-server/commit/3cd7cd2066f)

--- percona-server-5.6.51-91.0.orig/sql/item_strfunc.cc
+++ percona-server-5.6.51-91.0/sql/item_strfunc.cc
@@ -2759,6 +2759,17 @@ void Item_func_make_set::fix_length_and_dec()
 }
 
 
+/* item is not in args[], Item_func::fix_after_pullout() would miss it */
+void Item_func_make_set::fix_after_pullout(st_select_lex *parent_select,
+                                           st_select_lex *removed_select)
+{
+  Item_func::fix_after_pullout(parent_select, removed_select);
+  item->fix_after_pullout(parent_select, removed_select);
+  used_tables_cache|=     item->used_tables();
+  not_null_tables_cache|= item->not_null_tables();
+  const_item_cache&=      item->const_item();
+}
+
 void Item_func_make_set::update_used_tables()
 {
   Item_func::update_used_tables();
--- percona-server-5.6.51-91.0.orig/sql/item_strfunc.h
+++ percona-server-5.6.51-91.0/sql/item_strfunc.h
@@ -618,6 +618,8 @@ public:
                       List<Item> &fields);
   void fix_length_and_dec();
   void update_used_tables();
+  void fix_after_pullout(st_select_lex *parent_select,
+                         st_select_lex *removed_select);
   const char *func_name() const { return "make_set"; }
 
   bool walk(Item_processor processor, bool walk_subquery, uchar *arg)
