+/*********************************************************************//**
+Checks whether a foreign key constraint contains a column with a full text
+index on it, in the context of a cascading DML operation.
+A self-referential constraint is skipped: the cascaded row operation on the
+same table marks the FTS doc id itself, marking it here as well deletes it
+twice and trips ut_a(result != FTS_INVALID) (Bug#36234681).
+@return true if an FTS indexed column of the child table is affected */
+static
+bool
+row_ins_foreign_fts_col_affected(
+/*=============================*/
+	const dict_foreign_t*	foreign)	/*!< in: foreign key */
+{
+	const dict_table_t*	table = foreign->foreign_table;
+
+	if (!table->fts || table == foreign->referenced_table) {
+		return(false);
+	}
+
+	for (ulint i = 0; i < foreign->n_fields; i++) {
+		if (dict_table_is_fts_column(
+			table->fts->indexes,
+			dict_index_get_nth_col_no(foreign->foreign_index, i))
+		    != ULINT_UNDEFINED) {
+			return(true);
+		}
+	}
+
+	return(false);
+}
+
