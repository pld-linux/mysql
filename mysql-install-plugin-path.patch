INSTALL PLUGIN with invalid characters in SONAME hung the server, the path
check ran before the charset check (Bug#27167197).
https://github.com/MariaDB/server/commit/8ddb7e3eb7

--- percona-server-5.5.62-38.14.orig/sql/sql_plugin.cc
+++ percona-server-5.5.62-38.14/sql/sql_plugin.cc
@@ -451,9 +451,9 @@ static st_plugin_dl *plugin_dl_add(const LEX_STRING *dl, int report)
     This is done to ensure that only approved libraries from the
     plugin directory are used (to make this even remotely secure).
   */
-  if (check_valid_path(dl->str, dl->length) ||
-      check_string_char_length((LEX_STRING *) dl, "", NAME_CHAR_LEN,
+  if (check_string_char_length((LEX_STRING *) dl, "", NAME_CHAR_LEN,
                                system_charset_info, 1) ||
+      check_valid_path(dl->str, dl->length) ||
       plugin_dir_len + dl->length + 1 >= FN_REFLEN)
   {
     report_error(report, ER_UDF_NO_PATHS);
