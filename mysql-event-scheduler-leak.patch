The event scheduler never freed its THD mem_root, memory grew with every
scheduled event until the server ran out of it (Bug#30628268).
https://github.com/MariaDB/server/commit/39c60116e8

--- percona-server-5.5.62-38.14.orig/sql/event_scheduler.cc
+++ percona-server-5.5.62-38.14/sql/event_scheduler.cc
@@ -509,6 +509,7 @@ Event_scheduler::run(THD *thd)
       DBUG_PRINT("info", ("job_data is NULL, the thread was killed"));
     }
     DBUG_PRINT("info", ("state=%s", scheduler_states_names[state].str));
+    free_root(thd->mem_root, MYF(0));
   }
 
   LOCK_DATA();
