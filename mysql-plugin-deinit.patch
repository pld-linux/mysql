Unified behaviour when calling plugin->deinit for all plugins
(Bug#36317795)
https://github.com/percona/percona-server/commit/5883b88cb0
https://github.com/mysql/mysql-server/commit/ce036717cb5

--- mysql-5.7.44.orig/plugin/audit_null/audit_null.c
+++ mysql-5.7.44/plugin/audit_null/audit_null.c
@@ -221,6 +221,7 @@ static int audit_null_plugin_init(void *arg MY_ATTRIBUTE((unused)))
 
 static int audit_null_plugin_deinit(void *arg MY_ATTRIBUTE((unused)))
 {
+  assert(arg);
   if (g_plugin_installed == TRUE)
   {
     my_free((void *)(g_record_buffer));
