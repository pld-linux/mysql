FTS doc id comparators returned the difference of two 64-bit doc ids
truncated to int, misordering doc ids more than 2^31 apart.
https://github.com/percona/percona-server/commit/d131e82d5c

--- percona-server-5.6.51-91.0.orig/storage/innobase/fts/fts0que.cc
+++ percona-server-5.6.51-91.0/storage/innobase/fts/fts0que.cc
@@ -358,7 +358,8 @@ fts_freq_doc_id_cmp(
 	const fts_doc_freq_t*	fq1 = (const fts_doc_freq_t*) p1;
 	const fts_doc_freq_t*	fq2 = (const fts_doc_freq_t*) p2;
 
-	return((int) (fq1->doc_id - fq2->doc_id));
+	/* doc ids are 64-bit, their difference does not fit in int */
+	return(fq1->doc_id < fq2->doc_id ? -1 : fq1->doc_id > fq2->doc_id ? 1 : 0);
 }
 
